[
 {
  "filename": "LJ0002",
  "text": "کیوں زیاں کار بنوں سود فراموش رہوں",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/0/audio/audio.w"
 },
 {
  "filename": "LJ0003",
  "text": "فکر فردا نہ کروں محو غم دوش رہوں",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/1/audio/audio.w"
 },
 {
  "filename": "LJ0004",
  "text": "نال بلبل کے سنوں اور ہمہ تن گوش رہوں",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/2/audio/audio.w"
 },
 {
  "filename": "LJ0005",
  "text": "ہم نوا میں بھی کوئی گل ہوں کہ خاموش رہوں",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/3/audio/audio.w"
 },
 {
  "filename": "LJ0006",
  "text": "جرأت آموز مری تاب سخن ہے مجھ کوشکوہ اللہ سے خاکم بدہن ہے مجھ کو",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/4/audio/audio.w"
 },
 {
  "filename": "LJ0007",
  "text": "ہے بجا شیوہ تسلیم میں مشہور ہیں ہم",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/5/audio/audio.w"
 },
 {
  "filename": "LJ0008",
  "text": "قصۂ درد سناتے ہیں کہ مجبور ہیں ہم",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/6/audio/audio.w"
 },
 {
  "filename": "LJ0009",
  "text": "ساز خاموش ہیں فریاد سے معمور ہیں ہم نالہ آتا ہے اگر لب پہ تو معذور ہیں ہم اے خدا شکوۂ اربابِ وفا بھی سن لے",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/7/audio/audio.w"
 },
 {
  "filename": "LJ0010",
  "text": "خوگر حمد سے تھوڑا سا گلا بھی سن لے",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/8/audio/audio.w"
 },
 {
  "filename": "LJ0011",
  "text": "تھی تو موجود ازل سے ہی تری ذاتِ قدیم",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/9/audio/audio.w"
 },
 {
  "filename": "LJ0012",
  "text": "پھول تھا زیبِ چمن، پر نہ پریشان تھی شمیم شرطِ انصاف ہے اے صاحبِ الطافِ عمیم بُوئے گل پھیلتی کس طرح جو ہوتی نہ نسیم",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/10/audio/audio."
 },
 {
  "filename": "LJ0013",
  "text": "ہم کو جمعیتِ خاطر یہ پریشانی تھی۔",
  "audio_meta": "[{'src': 'https://datasets-server.huggingface.co/assets/muhammadsaadgondal/urdu-tts/--/1a57192888304283e2b3b3c136846702b7e11057/--/default/train/11/audio/audio."
 }
]