+    # Local patch: keep the GPU at a steady, moderate temperature so the fans stay quiet
+    # (same rules as stt-v2-finetune/src/training/thermal.py). After each micro-batch: rest
+    # GAIN seconds per degree above TARGET (capped), and if it still reaches PAUSE, wait
+    # until it is back to RESUME. Fails open if the temperature can't be read.
+    import subprocess
+    import time as _time
+
+    _target = float(os.environ.get("THERMAL_TARGET_C", 65))
+    _gain, _max_rest = 0.25, 4.0
+    _pause, _resume = float(os.environ.get("THERMAL_PAUSE_C", 75)), float(os.environ.get("THERMAL_RESUME_C", 65))
+    _thermal = {"rested_s": 0.0, "pauses": 0, "peak": 0}
+
+    def _gpu_temp():
+        try:
+            out = subprocess.run(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"],
+                                 capture_output=True, text=True, timeout=10)
+            return int(out.stdout.strip().splitlines()[0])
+        except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
+            return None
+
+    def thermal_pace():
+        t = _gpu_temp()
+        if t is None:
+            return
+        _thermal["peak"] = max(_thermal["peak"], t)
+        if t >= _pause:
+            _thermal["pauses"] += 1
+            start = _time.time()
+            while t is not None and t > _resume and _time.time() - start < 600:
+                _time.sleep(1)
+                t = _gpu_temp()
+            _thermal["rested_s"] += _time.time() - start
+        elif t > _target:
+            rest = min(_max_rest, _gain * (t - _target))
+            _time.sleep(rest)
+            _thermal["rested_s"] += rest
+
